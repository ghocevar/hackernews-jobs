{
  "name": "hackernews-jobs",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "next build",
    "start": "next start",
    "test": "go test ./... && node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/*.test.ts",
    "lint": "biome lint . && bash scripts/gofmt-check.sh",
    "format": "biome format --write . && gofmt -w hn api cmd",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false . && bash scripts/gofmt-check.sh"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
